{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-origin",
    "rootDir": "src",
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/cliOrigin.ts",
    "src/verifyOrigin.ts",
    "src/verifyChannel.ts",
    "src/verifyRelease.ts",
    "src/releasePayload.ts",
    "src/releaseSigning.ts",
    "src/trustedKeys.ts",
    "src/io.ts",
    "src/types.ts",
    "src/paths.ts",
    "src/resourcePackPaths.ts",
    "src/resourcePackTypes.ts",
    "src/resourcePackManifest.ts",
    "src/version.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
